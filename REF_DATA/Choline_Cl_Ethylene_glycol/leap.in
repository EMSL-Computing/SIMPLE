source leaprc.gaff2
source leaprc.water.spce
#loadOff atomic_ions.lib
loadamberparams CH1_h.frcmod
loadamberparams EG1_h.frcmod
loadamberparams frcmod.ions1lm_1264_spce
#loadamberparams frcmod.ions234lm_1264_spce
loadoff CH1_h_ptmpsi.lib
loadoff EG1_h_ptmpsi.lib
DES = loadpdb DES_1000_2000.pdb
Check DES
charge DES
#saveAmberParm M01 R1_h_gas.prmtop R1_h_gas.inpcrd
#addIons DES Br- 1
Check DES
charge DES
#solvateBox M01 SPC 15
set DES box {150.0 150.0 150.0}
saveAmberParm DES DES.prmtop DES.inpcrd
quit



