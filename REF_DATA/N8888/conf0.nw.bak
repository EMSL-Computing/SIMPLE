xtb
 acc 0.1
end

driver
 maxiter 900
end

task xtb optimize ignore

basis "ao basis" spherical
 * library def2-tzvp
end

basis "cd basis" spherical bse
 * library def2-universal-jfit
end


dft
  noio
  disp vdw 4
  xc r2scan
  grid lebedev 120 14 nodisk
  mult 1
  maxiter 100
  convergence lshift 0.1 energy 1d-7
  noprint "final vectors analysis"
end

driver
 maxiter 60
end

task dft optimize ignore


unset "dft:cd*"
unset "basis:cd*"

basis "ao basis" spherical
 * library 6-31g*
end

dft
 xc hfexch 1.0
 vectors input atomic
end

task dft


esp
 
 restrain hfree
end

task esp
